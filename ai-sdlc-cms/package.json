{
  "name": "ai-sdlc-cms",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd web && npm install && npm run build",
    "dev": "node dev.js",
    "test": "node test.js && node test-telegram.js",
    "typecheck": "npm --prefix web run typecheck",
    "sync": "node sync-process.js",
    "pack": "node pack.js",
    "deploy": "node pack.js && node upload.js"
  },
  "description": "CMS theo dõi tiến độ dự án theo quy trình AI-SDLC",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "ssh2-sftp-client": "^12.1.1"
  }
}
